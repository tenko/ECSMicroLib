Function ABS(x : ANYNUM): TYPEOF(x) |Absolute value of x
Function ASH(x : ANYINT; n : INTEGER): TYPEOF(x) |Arithmetic shift left (x ∗ 2^n)
Function CAP(x : CHAR): CHAR |Corresponding capital letter of x
Function CHR(x : ANYINT): CHAR |Character with ordinal number x
Function ENTIER(x : ANYREAL): ANYINT |Largest integer not greater than x
Function LEN(v : ANYARRAY; [n : INTEGER]): LENGTH |Length of v in dimension n (first dimension = 0)
Function LONG(x : ANYINT): ANYINT |Idenity
Function MAX(t : TYPE): TYPE|INTEGER |Maximum value fo TYPE or maximum value of element in SET type
Function MIN(t : TYPE): TYPE|INTEGER |Minimum value fo TYPE or minomum value of element in SET type (0)
Function ODD(x : ANYINT): BOOLEAN |x MOD 2 = 1
Function ORD(x : CHAR): INTEGER |Ordinal number of x
Function SHORT(x : ANYINT): ANYINT |Idenity
Function SIZE(x : ANYTYPE): INTEGER |Number of bytes needed to represent TYPEOF(x)
Function IM(x : ANYCPLX): ANYINT |Imaginary part of complex number x
Function PTR(x : ANYTYPE): POINTER TO TYPEOF(x) |Return pointer to x
Function RE(x : ANYCPLX): ANYINT |Real part of complex number x
Function SEL(expr1; expr2; expr3) |IF expr1 THEN expr2 ELSE expr3 END
Function ASSERT(expr; [n : INTEGER]) |Terminate program execution if not x
Function COPY(x- : ARRAY OF CHAR; VAR v : ARRAY OF CHAR) |v := x
Function DEC(v : ANYINT; [n : INTEGER]) | v := v - 1|n
Function EXCL(v : ANYSET; n : INTEGER) | v := v - n
Function HALT(n : INTEGER) |Terminate program execution with error code n
Function INC(v : ANYINT; [n : INTEGER]) | v := v + 1|n
Function INCL(v : ANYSET; n : INTEGER) | v := v - n
Function NEW(v : POINT TO ANYTYPE; [n1..nn : LENGTH]) | Allocate pointer to record/fixed array or pointer to open array
Function DISPOSE(v : POINT TO ANYTYPE) | Deallocate pointer to record/array and set v to NIL
Function IGNORE(expr) | Evalute expr and ignore result
Function TRACE(expr) | Print output of result of expr evaluation
Function SYSTEM.ADR(v : ANYTYPE): SYSTEM.ADDRESS |Address of variable v
Function SYSTEM.BIT(a : SYSTEM.ADDRESS; n : LENGTH): BOOLEAN |Bit n of Mem[a]
Function SYSTEM.LSH(x : ANYINT; n : INTEGER): TYPEOF(x) |Logical shift x +/-n bits
Function SYSTEM.ROT(x : ANYINT; n : INTEGER): TYPEOF(x) |Rotate x +/-n bits
Function SYSTEM.VAL(T : ANYTYPE; x : TYPEOF(T)): TYPEOF(T) |x interpreted as of type T
Function SYSTEM.GET(a : SYSTEM.ADDRESS; v : ANYTYPE) |v := Mem[a]
Function SYSTEM.PUT(a : SYSTEM.ADDRESS; v : ANYTYPE) |Mem[a] := v
Function SYSTEM.MOVE(a0, a1 : SYSTEM.ADDRESS; n : LENGTH) | Mem[a1..a1+n-1] := Mem[a0..a0+n-1]
Function SYSTEM.NEW(v : POINT TO ANYTYPE; [n1..nn : LENGTH]) | Allocate pointer to record/fixed array or pointer to open array
Function SYSTEM.ASM(string) | Generate inline assebler
Function SYSTEM.CODE(string) | Generate intermediate code
Function SYSTEM.DISPOSE(v : POINT TO ANYTYPE) | Deallocate pointer to record/array and set v to NIL
