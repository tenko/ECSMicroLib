            GPIOF_IDR*       = ADDRESS(GPIOF + 10H);
            GPIOF_ODR*       = ADDRESS(GPIOF + 14H);
            GPIOF_BSRR*      = ADDRESS(GPIOF + 18H);
            GPIOF_LCKR*      = ADDRESS(GPIOF + 1CH);
            GPIOF_AFRL*      = ADDRESS(GPIOF + 20H);
            GPIOF_AFRH*      = ADDRESS(GPIOF + 24H);
        GPIOG* = ADDRESS(42021800H);
