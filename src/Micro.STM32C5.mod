            GPIOH_OTYPER*    = ADDRESS(GPIOH + 4);
            GPIOH_OSPEEDR*   = ADDRESS(GPIOH + 8);
            GPIOH_PUPDR*     = ADDRESS(GPIOH + 0CH);
