            GPIOE_AFRL*      = ADDRESS(GPIOE + 20H);
            GPIOE_AFRH*      = ADDRESS(GPIOE + 24H);
        GPIOF* = ADDRESS(42021400H);
            GPIOF_MODER*     = ADDRESS(GPIOF + 0);
