            GPIOC_PUPDR*     = ADDRESS(GPIOC + 0CH);
            GPIOC_IDR*       = ADDRESS(GPIOC + 10H);
            GPIOC_ODR*       = ADDRESS(GPIOC + 14H);
            GPIOC_BSRR*      = ADDRESS(GPIOC + 18H);
            GPIOC_LCKR*      = ADDRESS(GPIOC + 1CH);
            GPIOC_AFRL*      = ADDRESS(GPIOC + 20H);
            GPIOC_AFRH*      = ADDRESS(GPIOC + 24H);
