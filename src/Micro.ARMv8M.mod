            NVICICER2*  = ADDRESS(0E000E188H);
            NVICICER3*  = ADDRESS(0E000E18CH);
            NVICICER4*  = ADDRESS(0E000E190H);
            NVICICER5*  = ADDRESS(0E000E194H);
