            NVICIPR11*  = ADDRESS(0E000E42CH);
            NVICIPR12*  = ADDRESS(0E000E430H);
            NVICIPR13*  = ADDRESS(0E000E434H);
            NVICIPR14*  = ADDRESS(0E000E438H);
            NVICIPR15*  = ADDRESS(0E000E43CH);
            NVICIPR16*  = ADDRESS(0E000E440H);
